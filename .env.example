# =====================================================================
# Скопируйте в .env и заполните:  cp .env.example .env
# =====================================================================

# ---------- Домен (для Nginx + Let's Encrypt; без https://) ----------
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
# Режим БЕЗ домена (работа по белому IP): раскомментируйте следующую строку,
# в DOMAIN впишите IP сервера, NEXTAUTH_URL=http://IP (без https!)
# NGINX_TEMPLATE=-ip

# ---------- PostgreSQL (compose создаёт БД, приложение подключается) ---
POSTGRES_USER=samui
# ВАЖНО: только буквы/цифры — спецсимволы ($ @ : / и т.п.) ломают DATABASE_URL
POSTGRES_PASSWORD=214152Aa
POSTGRES_DB=samui
# DATABASE_URL собирается автоматически в docker-compose.yml.
# Для локальной разработки без Docker раскомментируйте и укажите свой:
# DATABASE_URL=postgresql://samui:samui@localhost:5432/samui?schema=public

# ---------- Next.js / Auth.js ----------
# Публичный адрес сайта (обязательно с https после установки SSL)
NEXTAUTH_URL=https://example.com
# Сгенерируйте: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Название сайта в шапке
NEXT_PUBLIC_SITE_NAME=Samui Rentals

# ---------- Telegram Bot API (уведомления) ----------
# 1) Создайте бота через @BotFather, получите токен
# 2) Добавьте бота в чат/канал админов, получите chat_id (@userinfobot)
TG_BOT_TOKEN=
TG_ADMIN_CHAT_ID=

# ---------- WhatsApp (укажите провайдера: green-api | meta) ----------
WHATSAPP_PROVIDER=
WHATSAPP_ADMIN_PHONE=
# Green-API (https://green-api.com): instanceId + token
WHATSAPP_GREEN_API_INSTANCE_ID=
WHATSAPP_GREEN_API_TOKEN=
# Meta WhatsApp Cloud API
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TOKEN=

# ---------- SMTP / Email (уведомления) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Куда дублировать уведомления о заявках (кроме email админов из CRM)
SMTP_ADMIN_EMAIL=

# ---------- Seed (первичный запуск, см. README) ----------
# Создание администратора при первом старте контейнера (RUN_SEED=true)
RUN_SEED=false
SEED_ADMIN_EMAIL=admin@samui.com
SEED_ADMIN_PASSWORD=Favorite6725/89*
SEED_ADMIN_NAME=Администратор
# Демо-данные (1 владелец + 3 объекта с фото-заглушками)
SEED_DEMO=false
